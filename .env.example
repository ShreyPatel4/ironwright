# Copy to .env for local runs. Never commit .env.
ONTOFORGE_ENV=local                 # local | staging | prod
ONTOFORGE_DATA=./data
ONTOFORGE_LLM=offline               # offline | ollama | cloudflare | anthropic | openai
# ONTOFORGE_LLM_MODEL=
# ONTOFORGE_OLLAMA_URL=http://localhost:11434
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
ONTOFORGE_PRINCIPAL=agent:mcp-client
# Planned (see docs/ROADMAP.md): daily LLM budget and live-run rate limit for staging/prod
# ONTOFORGE_LLM_DAILY_TOKENS=200000
# ONTOFORGE_RUNS_PER_IP_PER_HOUR=5
