# Copy to .env for local runs. Never commit .env.
IRONWRIGHT_ENV=local                 # local | staging | prod
IRONWRIGHT_DATA=./data
IRONWRIGHT_LLM=offline               # offline | ollama | cloudflare | anthropic | openai
# IRONWRIGHT_LLM_MODEL=
# IRONWRIGHT_OLLAMA_URL=http://localhost:11434
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
IRONWRIGHT_PRINCIPAL=agent:mcp-client
# Planned (see docs/ROADMAP.md): daily LLM budget and live-run rate limit for staging/prod
# IRONWRIGHT_LLM_DAILY_TOKENS=200000
# IRONWRIGHT_RUNS_PER_IP_PER_HOUR=5
