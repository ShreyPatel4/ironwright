# Copy to .env for local runs. Never commit .env.
IRONWRIGHT_ENV=local                 # local | staging | prod
IRONWRIGHT_DATA=./data
# Seals org model keys and two-step sign in secrets. Required on staging and prod, or the server will not start.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IRONWRIGHT_SECRET_KEY=
IRONWRIGHT_LLM=offline               # offline | ollama | cloudflare | anthropic | openai
# IRONWRIGHT_LLM_MODEL=
# IRONWRIGHT_OLLAMA_URL=http://localhost:11434
# CF_ACCOUNT_ID=
# CF_API_TOKEN=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
IRONWRIGHT_PRINCIPAL=agent:mcp-client
# Planned (see docs/ROADMAP.md): daily LLM budget and live-run rate limit for staging/prod
# IRONWRIGHT_LLM_DAILY_TOKENS=200000
# IRONWRIGHT_RUNS_PER_IP_PER_HOUR=5
# Auth (docs/enterprise-security.md). Links in mail start with the public URL, never the Host header.
# IRONWRIGHT_PUBLIC_URL=https://coconutlabs.org
# IRONWRIGHT_MAIL=file                # file (local inbox at <data>/outbox/mail.jsonl) | resend
# IRONWRIGHT_MAIL_KEY=
# IRONWRIGHT_MAIL_FROM=Ironwright <no-reply@coconutlabs.org>
# IRONWRIGHT_COOKIE_SECURE=1          # 0 only for plain http on a LAN name; localhost needs no change
