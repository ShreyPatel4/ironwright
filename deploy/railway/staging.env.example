# Every variable the staging service needs. Set them on the Railway service.
# Secrets stay blank here. ${{...}} is Railway's own reference syntax.
IRONWRIGHT_ENV=staging
IRONWRIGHT_HOST=0.0.0.0
IRONWRIGHT_I_KNOW_THIS_IS_EXPOSED=1
IRONWRIGHT_DATA=/data
IRONWRIGHT_RUNS_WAIT=0
IRONWRIGHT_DB_URL=${{Postgres.DATABASE_URL}}
IRONWRIGHT_LAKE_URI=s3://ironwright-staging/staging
IRONWRIGHT_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
IRONWRIGHT_SECRET_KEY=
IRONWRIGHT_SEED_PASSWORD=
RAILWAY_RUN_UID=0
